# ---------------------------------------------------------------------------
# Datasets and runtime artifacts
# ---------------------------------------------------------------------------
# credit_risk datasets are gigabytes of fetched source data, rebuilt by the
# scripts in projects/credit_risk/dataset/. The builders and docs are tracked; the data
# is not.
projects/credit_risk/dataset/**
!projects/credit_risk/dataset/**/
!projects/credit_risk/dataset/**/*.py
!projects/credit_risk/dataset/*.md
!projects/credit_risk/dataset/**/*.md
projects/credit_risk/output/
# Anchored: an unanchored `data/` would also swallow backend/data/graphs.
/data/

# Studio runtime state. Workflow definitions are the source of truth for what
# a user built, so those are tracked; everything a run produces is not.
backend/data/runs/
backend/data/batches/
backend/data/memory/
backend/data/agent-memory/
backend/data/workspace/
backend/data/evolve/
backend/data/reviews/
backend/data/watch/
backend/data/tables/
backend/data/stm/
backend/data/schedules/
backend/data/skills/
backend/data/tools/
backend/data/.cleared-*/

# Frontend
backend/node_modules/
frontend/node_modules/
frontend/dist/

examples/output/

# Small reviewed source manifests; fetched release data stays ignored.
!projects/credit_risk/dataset/review/event_reviews.json
!projects/credit_risk/dataset/expansion/curated_events.json
!projects/credit_risk/dataset/expansion/web_sources.json
!projects/credit_risk/dataset/expansion/review_backfill.json
!projects/credit_risk/dataset/review/outcome_audit_2026-09-09.json

!projects/credit_risk/dataset/review/body_quality_2026-09-09.json
!projects/credit_risk/dataset/review/followup_checks_2026-09-09.json

!projects/credit_risk/dataset/review/industry_annotations_2026-09-09.json

backend/data/projects/

# Mem0 shared spaces, vectors, and edit history
backend/data/mem0/

# Private workstation state (never publish)
backend/data/
backend/api/workplace/
backend/llm/providers.json
backend/data/memory-backups/
*.sqlite
*.sqlite3
*.db
*.pem
*.key
.ruff_cache/
# Frozen release distributed with this repository
!projects/credit_risk/dataset/expansion/releases/2026-09-10-random-dev-test-v1/**

# Saved workflow definitions only; all other runtime state stays private.
!backend/data/
backend/data/*
!backend/data/graphs/
backend/data/graphs/*
!backend/data/graphs/credit-risk-monitoring.json
!backend/data/graphs/credit-risk-monitoring-before-evolve.json
!backend/data/graphs/supplier-credit-risk-monitor.json

# Required definition for the published supplier workflow.
!backend/data/skills/
backend/data/skills/*
!backend/data/skills/supplier_distress_rubric/
backend/data/skills/supplier_distress_rubric/*
!backend/data/skills/supplier_distress_rubric/SKILL.md
